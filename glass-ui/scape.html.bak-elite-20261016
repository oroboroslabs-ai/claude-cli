  ctx.globalAlpha = 0.22; ctx.fillStyle = c[0];
  ctx.beginPath(); ctx.arc(P.sx,P.sy,R*1.22,0,7); ctx.fill();
  ctx.globalAlpha = 0.18;
  ctx.beginPath(); ctx.arc(P.sx,P.sy,R*1.5,0,7); ctx.fill();
  ctx.globalAlpha = 1;
  let g;
  // body
  g = ctx.createRadialGradient(P.sx-R*0.35, P.sy-R*0.35, R*0.05, P.sx,P.sy,R);
  g.addColorStop(0,"#f4f4f2"); g.addColorStop(0.30, c[1]); g.addColorStop(0.85, c[0]); g.addColorStop(1, FA(c[0],1));
  ctx.fillStyle=g; ctx.beginPath(); ctx.arc(P.sx,P.sy,R,0,7); ctx.fill(); ctx.strokeStyle=FA('#5a5a54',.65); ctx.lineWidth=1.2*DPR; ctx.beginPath(); ctx.arc(P.sx,P.sy,R,0,7); ctx.stroke();  // LIGHT RING
  // lock ring
  if(n.id==="nlock"){ ctx.strokeStyle="rgba(169,124,47,.9)"; ctx.lineWidth=2*DPR; ctx.beginPath(); ctx.arc(P.sx,P.sy,R*1.34,time*0.8,time*0.8+5.3); ctx.stroke(); }
  if(n===sel){ ctx.strokeStyle="rgba(240,197,117,.95)"; ctx.lineWidth=1.6*DPR; ctx.beginPath(); ctx.arc(P.sx,P.sy,R+7*DPR,0,7); ctx.stroke(); }
  // label
  const show = (n===hover||n===sel||n.up===true||zoom>1.6||T.focus===false);
  if(show && n.kind!=="void"){
    ctx.font=`700 ${10.5*DPR}px Inter,system-ui`;
    ctx.fillStyle = document.body.classList.contains("dark") ? (n===hover? "#ffffff" : FA("#e8e8e2",.95)) : (n===sel? "#111" : (n===hover? "#000" : FA("#111",.95)));
    ctx.textAlign="center";
    ctx.fillText(n.label, P.sx, P.sy - R - 9*DPR);
  }
}
function FA(hex,a){ const v=parseInt(hex.slice(1),16); return `rgba(${v>>16&255},${v>>8&255},${v&255},${a})`; }

let vitals = "";

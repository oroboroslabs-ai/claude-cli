  box.appendChild(me); box.scrollTop = box.scrollHeight;
  document.getElementById("vin").value = "";
  HIST.push({ role: "user", content: text });
  let r;
  if(CH_MODE === "harness"){
    r = await fetch(HARNESS_URL, { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ messages: HIST.slice(-12), model: HARNESS_MODEL }) }).catch(e=>null);
  } else {
    r = await fetch("/api/chat", { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ messages: HIST.slice(-12), model: CH_MODE === "deep" ? DEEP_MODEL : "oroboros-labs/claude-fable7-undecillion-sse" }) }).catch(e=>null);
  }
  if(r && r.ok){
    const d = await r.json();
    let a = "";
    const c = d && d.choices && d.choices[0] && d.choices[0].message;
    a = (d.response ? d.response : (d.message ? (typeof d.message.content === "string" ? d.message.content : JSON.stringify(d.message.content)) : (c ? (c.content||"") : (d.content||"")))) || "";
    if(typeof a !== "string") a = JSON.stringify(a);
    const ai = document.createElement("div"); ai.className = "msg";
    ai.innerHTML = '<div class="who">OROBOROS ANTHROPIC</div>' + esc(a.slice(0, 1500));
    box.appendChild(ai); box.scrollTop = box.scrollHeight;
    HIST.push({ role: "assistant", content: a });
    if(VO.on) speakTTS(a);
  } else {
    const ai = document.createElement("div"); ai.className = "msg";
    ai.innerHTML = '<div class="who">BACKEND</div>The chat bridge did not answer (' + (r? r.status : "network") + '). Run J:\\start-systemscape.bat.';
    box.appendChild(ai); box.scrollTop = box.scrollHeight;
  }
}

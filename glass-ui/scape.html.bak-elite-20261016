function drawOrb(n, time){
  const p = layout(n,time);
  const P = project(p); PROJ.set(n.id,P);
  if(!isFinite(P.sx)||!isFinite(P.sy)) return;
  const base = (n.kind==="void"? 3.2 : 10 + n.ring*6.0)*DPR;
  const RR = Math.max(5, base * Math.min(1.0, Math.max(0.42, 1.14 - 0.09*P.persp)) * zoom);
  const c = NODECOLORS[n.id] || PAL()[n.kind] || PAL().core;
  const pul = (n.up===true? 1+0.32*Math.sin(time*2.6+n.th*5) : n.up===false? 0.62 : 0.8+0.06*Math.sin(time+n.th));
  const R = RR*(n.id==="nlock"? (1+0.3*Math.sin(time*1.7)) : 1)*pul;

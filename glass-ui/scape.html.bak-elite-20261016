<script>
function dial(){
  const rc=document.getElementById("ringcv"); if(!rc) return;
  const c=rc.getContext("2d"); const S=380, C=S/2;
  c.clearRect(0,0,S,S);
  const up=nds.filter(n=>n.up===true).length, tot=nds.length;
  const frac= tot? up/tot : 0;
  const T0=-Math.PI/2;
  const dark=document.body.classList.contains("dark");
  const INK=dark? "#f2f2ee":"#171716";
  c.strokeStyle=dark? "rgba(255,255,255,.12)":"rgba(23,23,22,.12)"; c.lineWidth=7;
  c.beginPath(); c.arc(C,C,120,0,Math.PI*2); c.stroke();
  c.strokeStyle="#55554f"; c.lineCap="round";
  c.beginPath(); c.arc(C,C,120,T0,T0+Math.PI*2*frac); c.stroke();
  c.strokeStyle=dark? "rgba(255,255,255,.35)":"rgba(23,23,22,.4)"; c.lineWidth=2;
  c.beginPath(); c.arc(C,C,96,0,Math.PI*2); c.stroke();
  for(let i=0;i<48;i++){ const a=T0+i*(Math.PI*2/48);
    const big=i%4===0;
    const r0=big?72:80, r1=94;
    c.strokeStyle=big? (dark?"rgba(255,255,255,.55)":"rgba(60,60,57,.55)") : (dark?"rgba(255,255,255,.3)":"rgba(23,23,22,.35)");
    c.lineWidth=big?2:1;
    c.beginPath(); c.moveTo(C+Math.cos(a)*r0, C+Math.sin(a)*r0); c.lineTo(C+Math.cos(a)*r1, C+Math.sin(a)*r1); c.stroke(); }
  for(let i=0;i<60;i++){ const a=T0+i*(Math.PI*2/60);
    c.strokeStyle=dark? "rgba(255,255,255,.16)":"rgba(23,23,22,.16)"; c.lineWidth=1;
    c.beginPath(); c.moveTo(C+Math.cos(a)*64, C+Math.sin(a)*64); c.lineTo(C+Math.cos(a)*69, C+Math.sin(a)*69); c.stroke(); }
  c.fillStyle=INK; c.textAlign="center";
  c.font="700 36px Inter"; c.fillText(String(up), C, C+4);
  c.font="600 13px Inter"; c.fillStyle=dark? "rgba(230,230,224,.8)":"rgba(60,60,57,.8)"; c.fillText("NODES LIVE", C, C+28);
  c.fillStyle="#44443f"; c.font="700 12px Inter"; c.fillText("NEURAL LOCK 1272", C, C+56);
}
setInterval(dial, 300); dial();
</script>
